{
  "name": "@cement-house/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "generate:feature-map": "node scripts/generate-feature-map.mjs"
  },
  "dependencies": {
    "@cement-house/db": "workspace:*",
    "@cement-house/types": "workspace:*",
    "@cement-house/utils": "workspace:*",
    "@prisma/client": "^5.14.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/jwt": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.13.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0"
  }
